---
interface Props { placement: 'hero' | 'closing' }
const { placement } = Astro.props;
const hero = placement === 'hero';
const slotClass = hero ? 'hero-icon-slot' : 'closing-slot';
const floatClass = hero ? 'hero-icon-float' : 'closing-float';
const tileClass = hero ? 'hero-icon-tile' : 'closing-tile';
---
<div class={hero ? 'hero-decor' : 'closing-decor'} aria-hidden="true">
  {hero ? <>
    <div class={`floating-slot ${slotClass} tile-calendar`} data-hero-icon="0"><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><rect x="5" y="9" width="38" height="34" rx="5"/><rect x="12" y="4" width="5" height="11" rx="2"/><rect x="31" y="4" width="5" height="11" rx="2"/><path d="M5 18h38v3H5Z" fill="#FFFFFF"/><g fill="#FFFFFF"><circle cx="13" cy="28" r="2.5"/><circle cx="35" cy="28" r="2.5"/><circle cx="13" cy="36" r="2.5"/><circle cx="24" cy="36" r="2.5"/><circle cx="35" cy="36" r="2.5"/></g><circle class="selected-day" cx="24" cy="28" r="2.5"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-group`} data-hero-icon="1"><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><circle cx="18" cy="16" r="7"/><circle cx="33" cy="19" r="5"/><path d="M5 42v-3a13 13 0 0 1 26 0v3Z"/><path d="M30 31a10 10 0 0 1 13 9v2h-9"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-hours`} data-hero-icon="2"><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><path d="M13 5h22M13 43h22M16 5c0 10 5 10 8 19s8 9 8 19M32 5c0 10-5 10-8 19s-8 9-8 19" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-line`} data-hero-icon="3"><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><rect x="5" y="6" width="38" height="31" rx="10"/><path d="M14 33v11l14-11Z"/><g fill="#FFFFFF"><circle cx="15" cy="22" r="2.7"/><circle cx="24" cy="22" r="2.7"/><circle cx="33" cy="22" r="2.7"/></g></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-pencil`} data-hero-icon="4"><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><path d="M8 30 29 9a7 7 0 0 1 10 10L18 40 4 44Z"/><path d="M4 44 8 30 18 40Z" fill="#FFFFFF"/><path d="m4 44 2-7 5 5Z" fill="#0D253D"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-book`} data-hero-icon="5"><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><rect x="5" y="5" width="38" height="38" rx="5"/><path class="book-spine" d="M12 5h6v38h-6Z"/><path class="book-spine" d="M24 34h13v3H24Z" opacity=".55"/></svg></div></div></div>
  </> : <>
    <div class={`floating-slot ${slotClass} tile-cap`}><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><path d="m3 19 21-12 21 12-21 12Z"/><path d="M12 26v9c0 5 6 8 12 8s12-3 12-8v-9l-12 7Z"/><path d="M42 20v13h-3V21Z"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-bulb`}><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><path d="M24 5c-9 0-16 7.2-16 16.1 0 5.9 3.1 10 7.3 12.9 1.2.9 1.7 2.3 1.7 3.8V39h14v-1.2c0-1.5.5-2.9 1.7-3.8 4.2-2.9 7.3-7 7.3-12.9C40 12.2 33 5 24 5Z"/><path d="M17 42h14v2H17Z" fill="#FFFFFF"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-ruler`}><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><rect x="15" y="4" width="18" height="40" rx="2"/><path d="M15 9h10v3H15zM15 16h6v3h-6zM15 23h10v3H15zM15 30h6v3h-6zM15 37h10v3H15z" fill="#FFFFFF"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-document`}><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><path d="M8 4h22l10 10v30H8Z"/><path d="M30 4v10h10Z" fill="#FFFFFF"/><path d="M15 24h18v3H15Zm0 7h18v3H15Z" fill="#FFFFFF"/></svg></div></div></div>
    <div class={`floating-slot ${slotClass} tile-bookmark`}><div class={`floating-float ${floatClass}`}><div class={`floating-tile ${tileClass}`}><svg viewBox="0 0 48 48"><path d="M12 4h24v40L24 36 12 44Z"/></svg></div></div></div>
  </>}
</div>
