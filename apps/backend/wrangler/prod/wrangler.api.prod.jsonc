{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tutorpal-api-prod",
	"main": "../../src/cloudflare-worker.ts",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"triggers": {
		"crons": []
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE_CACHE_DISABLED",
			"id": "a46e2a0ffe424e02b9f2132af7fc821c"
		}
	],
	"vars": {
		"CORS_ORIGIN": "https://app.tutorpal.io",
		"ADMIN_FRONTEND_URL": "https://admin.tutorpal.io",
		"BETTER_AUTH_URL": "https://api.tutorpal.io",
		"ENVIRONMENT": "prod",
		"LOG_LEVEL": "info",
		"RESEND_FROM_EMAIL": "TutorPal <no-reply@tutorpal.io>",
		"LINE_LINK_REDIRECT_URL": "https://api.tutorpal.io/v1/line/callback",
		"FRONTEND_URL": "https://app.tutorpal.io",
		"EMAIL_VERIFICATION_CALLBACK_URL": "https://app.tutorpal.io/verify-email",
		"BETA_ENABLED": "true",
		"MARKETING_ORIGIN": "https://tutorpal.io"
	},
	"routes": [
		{
			"pattern": "api.tutorpal.io",
			"zone_name": "tutorpal.io",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
			"destinations": ["grafana-cloud-logs"]
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1,
			"destinations": ["grafana-cloud-traces"]
		}
	},
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"RESEND_API_KEY",
			"LINE_CREDENTIALS_ENCRYPTION_KEY"
		]
	}
}
