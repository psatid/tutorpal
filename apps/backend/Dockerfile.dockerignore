!apps/marketing-frontend/
!apps/marketing-frontend/package.json
!packages/
!packages/ui/
!packages/ui/package.json
!apps/backend/prisma/
!apps/backend/prisma/**
!apps/backend/src/
!apps/backend/src/**
!apps/backend/scripts/
!apps/backend/scripts/build-api.ts
!apps/backend/tsconfig.json
