{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tutorpal-marketing-dev",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": { "directory": "../../dist", "not_found_handling": "404-page" },
  "routes": [
    {
      "pattern": "dev.tutorpal.io",
      "zone_name": "tutorpal.io",
      "custom_domain": true,
    },
  ],
}
