---
import '../styles/global.css';
import { copy, type Locale } from '../content';
interface Props { lang: Locale; noindex?: boolean; title?: string; }
const { lang, noindex = false, title } = Astro.props;
const c = copy[lang];
const canonical = `https://tutorpal.io${lang === 'en' ? '/' : '/th/'}`;
const schema = { '@context':'https://schema.org', '@graph': [
 { '@type':'Organization', '@id':'https://tutorpal.io/#organization', name:'TutorPal', url:'https://tutorpal.io/', logo:'https://tutorpal.io/app-icon.png' },
 { '@type':'WebSite', '@id':'https://tutorpal.io/#website', name:'TutorPal', url:'https://tutorpal.io/', inLanguage:['en','th'], publisher:{'@id':'https://tutorpal.io/#organization'} }
] };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#FFFFFF" /><title>{title ?? c.title}</title>
  <meta name="description" content={c.description} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href="https://tutorpal.io/" />
    <link rel="alternate" hreflang="th" href="https://tutorpal.io/th/" />
    <link rel="alternate" hreflang="x-default" href="https://tutorpal.io/" />
  </>}
  <link rel="icon" href="/app-icon-small.png" type="image/png" />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="TutorPal" />
  <meta property="og:title" content={title ?? c.title} /><meta property="og:description" content={c.description} />
  <meta property="og:url" content={canonical} /><meta property="og:locale" content={lang === 'en' ? 'en_US' : 'th_TH'} />
  <meta property="og:image" content="https://tutorpal.io/social.png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="TutorPal — Plan, manage, track all in one place." />
  <meta name="twitter:card" content="summary_large_image" />
  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body><a class="skip-link" href="#main">{c.skip}</a><slot /></body>
</html>
