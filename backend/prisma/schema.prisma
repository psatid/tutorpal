generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id          String   @id @default(uuid())
  tutorId     String
  name        String
  phoneNumber String?
  grade       Int
  lineUserId  String?
  lineConnectionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tutor          Tutor               @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  classes        ClassEnrollment[]
  lineLinkTokens LineLinkToken[]
  lineConnection TutorLineConnection? @relation(fields: [lineConnectionId], references: [id], onDelete: SetNull)
  reminderDeliveries ClassReminderDelivery[]

  @@index([tutorId])
  @@index([lineConnectionId])
  @@unique([tutorId, lineUserId])
  @@map("students")
}

model Course {
  id                String   @id @default(uuid())
  tutorId           String
  name              String
  defaultTotalHours Decimal  @db.Decimal(10, 2)
  pricingMode       CoursePricingMode
  priceAmount       Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([tutorId, name])
  @@map("courses")
}

enum CoursePricingMode {
  HOURLY_RATE
  FIXED_PRICE

  @@map("course_pricing_mode")
}

model Class {
  id         String   @id @default(uuid())
  tutorId    String
  name       String
  totalHours Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tutor              Tutor              @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  students           ClassEnrollment[]
  schedules          Schedule[]
  recurringSchedules RecurringSchedule[]
  hourAdditions      ClassHourAddition[]

  @@index([tutorId])
  @@map("classes")
}

enum ClassHourAdditionSource {
  COURSE
  CUSTOM

  @@map("class_hour_addition_source")
}

model ClassHourAddition {
  id               String                  @id @default(uuid())
  classId          String
  source           ClassHourAdditionSource
  hours            Decimal                 @db.Decimal(10, 2)
  revenueAmount    Decimal?                @db.Decimal(12, 2)
  sourceCourseId   String?
  sourceCourseName String?
  requestId        String                  @db.Uuid
  createdAt        DateTime                @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, requestId])
  @@index([classId, createdAt, id])
  @@index([sourceCourseId])
  @@map("class_hour_additions")
}

// Join table for many-to-many relationship
model ClassEnrollment {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@map("class_enrollments")
}

model Tutor {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  students       Student[]
  classes        Class[]
  courses        Course[]
  lineConnection TutorLineConnection?

  @@map("tutors")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  tutor         Tutor?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LineLinkToken {
  id        String    @id @default(uuid())
  studentId String
  connectionId String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  student    Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  connection TutorLineConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([studentId])
  @@index([connectionId])
  @@map("line_link_tokens")
}

model TutorLineConnection {
  id                           String   @id @default(uuid())
  tutorId                      String   @unique
  messagingAccessTokenEncrypted String
  loginChannelId               String
  loginChannelSecretEncrypted  String
  accountName                  String
  accountBasicId               String?
  botUserId                    String
  testRecipientLineUserId      String?
  lastVerifiedAt               DateTime @default(now())
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  tutor              Tutor                    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  students           Student[]
  studentLinkTokens  LineLinkToken[]
  testRecipientTokens LineTestRecipientToken[]

  @@map("tutor_line_connections")
}

model LineTestRecipientToken {
  id           String   @id @default(uuid())
  connectionId String
  token        String   @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())

  connection TutorLineConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([token])
  @@map("line_test_recipient_tokens")
}

enum ScheduleStatus {
	SCHEDULED
	COMPLETED
	NO_SHOW
	CANCELLED

	@@map("schedule_status")
}

enum ScheduleType {
	ON_SITE
	ONLINE

	@@map("schedule_type")
}

model Schedule {
	id              String         @id @default(uuid())
	classId         String
	recurringScheduleId String?
	date            DateTime       @db.Date
	time            Int
	durationMinutes Int
	notes           String?
	status          ScheduleStatus @default(SCHEDULED)
	type            ScheduleType   @default(ON_SITE)
	createdAt       DateTime       @default(now())
	updatedAt       DateTime       @updatedAt

  class             Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  recurringSchedule RecurringSchedule?  @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  hourDeduction     ClassHourDeduction?
  reminderDeliveries ClassReminderDelivery[]

  @@index([classId])
  @@index([date])
  @@index([status, date])
  @@index([recurringScheduleId])
  @@map("schedules")
}

model ClassHourDeduction {
  id            String    @id @default(uuid())
  scheduleId    String    @unique
  classId       String
  hoursDeducted Float // Hours deducted (durationMinutes / 60)
  deductedAt    DateTime  @default(now())
  restoredAt    DateTime? // When hours were restored (if schedule is cancelled)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([scheduleId])
  @@map("class_hour_deductions")
}

model RecurringSchedule {
	id        String   @id @default(uuid())
	classId   String
	startDate DateTime @db.Date
	notes     String?
	type      ScheduleType @default(ON_SITE)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

  class         Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  scheduleItems RecurringScheduleItem[]
  schedules     Schedule[]

  @@index([classId])
  @@map("recurring_schedules")
}

enum ClassReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@map("class_reminder_delivery_status")
}

model ClassReminderDelivery {
  id               String                      @id @default(uuid())
  scheduleId       String
  studentId        String
  scheduledStartAt DateTime                    @db.Timestamptz(3)
  dueAt            DateTime                    @db.Timestamptz(3)
  status           ClassReminderDeliveryStatus @default(PENDING)
  retryKey         String                      @unique
  attemptCount     Int                         @default(0)
  nextAttemptAt    DateTime?                   @db.Timestamptz(3)
  leaseExpiresAt   DateTime?                   @db.Timestamptz(3)
  lineConnectionId String
  recipientLineUserId String
  message          String
  lastErrorCode    String?
  providerRequestId String?
  sentAt           DateTime?                   @db.Timestamptz(3)
  createdAt        DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @db.Timestamptz(3)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId, scheduledStartAt])
  @@index([status, dueAt])
  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@index([scheduleId])
  @@index([studentId])
  @@map("class_reminder_deliveries")
}

model RecurringScheduleItem {
  id                  String  @id @default(uuid())
  recurringScheduleId String
  weekday             Weekday
  time                Int
  durationMinutes     Int

  recurringSchedule RecurringSchedule @relation(fields: [recurringScheduleId], references: [id], onDelete: Cascade)

  @@index([recurringScheduleId])
  @@map("recurring_schedule_items")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}
