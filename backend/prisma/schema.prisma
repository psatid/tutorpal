
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id          String   @id @default(uuid())
  name        String
  phoneNumber String?
  grade       Int
  lineUserId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-many relation with Class through ClassEnrollment
  classes   ClassEnrollment[]
  lineLinkTokens LineLinkToken[]

  @@map("students")
}

model Class {
  id          String   @id @default(uuid())
  name        String
  totalHours  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-many relation with Student through ClassEnrollment
  students   ClassEnrollment[]
  schedules  Schedule[]
  recurringSchedules RecurringSchedule[]

  @@map("classes")
}

// Join table for many-to-many relationship
model ClassEnrollment {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@map("class_enrollments")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model LineLinkToken {
  id        String    @id @default(uuid())
  studentId String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([studentId])
  @@map("line_link_tokens")
}

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("schedule_status")
}

model Schedule {
  id               String             @id @default(uuid())
  classId          String
  date             DateTime           @db.Date
  time             Int
  durationMinutes  Int
  notes            String?
  status           ScheduleStatus     @default(SCHEDULED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  class            Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  hourDeduction    ClassHourDeduction?

  @@index([classId])
  @@index([date])
  @@map("schedules")
}

model ClassHourDeduction {
  id                 String    @id @default(uuid())
  scheduleId         String    @unique
  classId            String
  hoursDeducted      Float     // Hours deducted (durationMinutes / 60)
  deductedAt         DateTime  @default(now())
  restoredAt         DateTime? // When hours were restored (if schedule is cancelled)

  schedule           Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([scheduleId])
  @@map("class_hour_deductions")
}

model RecurringSchedule {
  id               String   @id @default(uuid())
  classId          String
  startDate        DateTime @db.Date
  durationMinutes  Int
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  class            Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  scheduleItems    RecurringScheduleItem[]

  @@index([classId])
  @@map("recurring_schedules")
}

model RecurringScheduleItem {
  id                    String   @id @default(uuid())
  recurringScheduleId   String
  weekday               Weekday
  time                  Int

  recurringSchedule     RecurringSchedule @relation(fields: [recurringScheduleId], references: [id], onDelete: Cascade)

  @@index([recurringScheduleId])
  @@map("recurring_schedule_items")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}
