{
	"name": "@tutorpal/backend",
	"scripts": {
		"dev": "bun run dev:json | pino-pretty --colorize --translateTime=SYS:standard",
		"dev:json": "bun run --hot src/index.ts",
		"cf:dev": "wrangler dev --config wrangler/dev/wrangler.api.dev.jsonc",
		"cf:check": "bun run cf:check:dev",
		"cf:check:dev": "wrangler deploy --config wrangler/dev/wrangler.api.dev.jsonc --dry-run --outdir dist/wrangler/dev/api",
		"cf:check:prod": "wrangler deploy --config wrangler/prod/wrangler.api.prod.jsonc --dry-run --outdir dist/wrangler/prod/api",
		"cf:deploy": "bun run cf:deploy:dev",
		"cf:deploy:dev": "wrangler deploy --config wrangler/dev/wrangler.api.dev.jsonc --keep-vars",
		"cf:deploy:prod": "bun run check:prod:config && wrangler deploy --config wrangler/prod/wrangler.api.prod.jsonc --keep-vars",
		"cf:reminders:dev": "wrangler dev --config wrangler/dev/wrangler.reminders.dev.jsonc --test-scheduled",
		"cf:reminders:check": "bun run cf:reminders:check:dev",
		"cf:reminders:check:dev": "wrangler deploy --config wrangler/dev/wrangler.reminders.dev.jsonc --dry-run --outdir dist/wrangler/dev/reminders",
		"cf:reminders:check:prod": "wrangler deploy --config wrangler/prod/wrangler.reminders.prod.jsonc --dry-run --outdir dist/wrangler/prod/reminders",
		"cf:reminders:deploy": "bun run cf:reminders:deploy:dev",
		"cf:reminders:deploy:dev": "wrangler deploy --config wrangler/dev/wrangler.reminders.dev.jsonc --keep-vars",
		"cf:reminders:deploy:prod": "bun run check:prod:config && wrangler deploy --config wrangler/prod/wrangler.reminders.prod.jsonc --keep-vars",
		"build:api": "bun run scripts/build-api.ts",
		"check:format": "biome check .",
		"check": "bun run check:dev",
		"check:dev": "bun run check:format && bun run cf:check:dev && bun run cf:reminders:check:dev",
		"check:prod:config": "bun run scripts/check-production-config.ts",
		"check:prod": "bun run check:format && bun run cf:check:prod && bun run cf:reminders:check:prod",
		"gen:openapi": "bun run scripts/download-openapi.ts",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:migrate:prod": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"bootstrap-admin": "bun run scripts/bootstrap-admin.ts"
	},
	"dependencies": {
		"@better-auth/prisma-adapter": "^1.5.6",
		"@hono/standard-validator": "0.2.2",
		"@hono/zod-openapi": "^1.2.4",
		"@prisma/adapter-pg": "7.5.0",
		"@prisma/client": "7.5.0",
		"@scalar/hono-api-reference": "0.10.4",
		"better-auth": "^1.5.6",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"dotenv": "^17.3.1",
		"hono": "4.11.3",
		"hono-openapi": "1.3.0",
		"mongoose": "8.23.0",
		"pg": "8.14.0",
		"pino": "^10.3.1",
		"prisma": "7.5.0",
		"resend": "^6.14.0",
		"serialize-error": "13.0.1",
		"uuid": "^13.0.0",
		"vitest": "4.1.0",
		"zod": "3.25.76",
		"zod-openapi": "4.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@faker-js/faker": "10.3.0",
		"@types/bun": "1.3.11",
		"@types/node": "^25.5.0",
		"@types/uuid": "^11.0.0",
		"bun-plugin-pino": "^1.5.0",
		"pino-pretty": "^13.1.3",
		"wrangler": "^4.121.0"
	}
}
