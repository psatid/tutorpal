{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tutorpal-reminders-prod",
	"main": "../../src/cloudflare-reminder-worker.ts",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	// Replace the Hyperdrive ID before production deployment.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE_CACHE_DISABLED",
			"id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_ID"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
			"destinations": ["tutorpal-grafana-logs"]
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1,
			"destinations": ["tutorpal-grafana-traces"]
		}
	},
	"secrets": {
		"required": ["LINE_CREDENTIALS_ENCRYPTION_KEY"]
	}
}
