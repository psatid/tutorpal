{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "tutorpal-api-prod",
	"main": "../../src/cloudflare-worker.ts",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"triggers": {
		"crons": []
	},
	// Replace every REPLACE_ value and .invalid URL before production deployment.
	// Configure the production custom domain/route in the deployment environment.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE_CACHE_DISABLED",
			"id": "REPLACE_WITH_PRODUCTION_HYPERDRIVE_ID"
		}
	],
	"vars": {
		"CORS_ORIGIN": "https://app.example.invalid",
		"ADMIN_FRONTEND_URL": "https://admin.example.invalid",
		"BETTER_AUTH_URL": "https://api.example.invalid",
		"ENVIRONMENT": "prod",
		"LOG_LEVEL": "info",
		"RESEND_FROM_EMAIL": "TutorPal <no-reply@example.invalid>",
		"LINE_LINK_REDIRECT_URL": "https://api.example.invalid/v1/line/callback",
		"FRONTEND_URL": "https://app.example.invalid",
		"EMAIL_VERIFICATION_CALLBACK_URL": "https://app.example.invalid/verify-email",
		"PUBLIC_SIGNUP_ENABLED": "false"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"RESEND_API_KEY",
			"LINE_CREDENTIALS_ENCRYPTION_KEY"
		]
	}
}
